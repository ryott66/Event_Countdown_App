rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === 管理者UIDリスト ===
    // .env の VITE_ADMIN_UIDS と同じUIDを並べる
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'XKLcoqNyiogQjyhw8KihRFDKNIL2',
        // 'HER_UID_HERE',
      ];
    }

    match /config/guestKey {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/galleries {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

